{
  "expo": {
    "name": "Route",
    "slug": "mobile-app-sk",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/route-icon.png",
    "scheme": "mobileappsk",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.solskilic.route",
      "icon": "./assets/images/route-icon.png"
    },
    "android": {
      "package": "com.solskilic.route",
      "adaptiveIcon": {
        "backgroundColor": "#F8F5EB",
        "foregroundImage": "./assets/images/route-icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      ["expo-image-picker", { "photosPermission": "Choose a photo to remember your progress in Route.", "cameraPermission": false, "microphonePermission": false }],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F8F5EB"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
